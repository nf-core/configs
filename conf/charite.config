// ---------------------------------------------
// Nextflow nf-core config file for Charité HPC
// ---------------------------------------------
//
// - Note on Usage
// -------------------------------
// Before using this config, please read the documentation (docs/charite.md) fully in order to setup your environment correctly
// If the environment variable PROJ_SCRATCHDIR_CHARITE_USER is not defined, your pipeline launch with this config will fail
// See docs/charite.md > "3. Environment Setup" to learn more
// -------------------------------
//
// - Note on Nextflow Strict Syntax
// -------------------------------
// The migration of Nextflow to strict syntax has been taken into account during the creation of this config
// It is therefore compatible with NXF_SYNTAX_PARSER=v2 (which is the default parser in Nextflow >=26.04)
// -------------------------------

// Profile metadata
params {
    config_profile_contact       = 'Scientific Computing, GB IT, Charité (@ScientificComputingCharite) | sc-hpc-helpdesk@charite.de'
    config_profile_description   = 'Scientific Computing Charité HPC Cluster Profile | Developed by Wassim Salam (@wassimsalam01) | Maintained by Scientific Computing, GB IT, Charité (@ScientificComputingCharite)'
    config_profile_name          = "charite"
    config_profile_url           = "https://www.charite.de/en/research/research_support_services/research_infrastructure/science_it"

    proj_scratchdir_charite_user = System.getenv("PROJ_SCRATCHDIR_CHARITE_USER")
}

// Instruct Nextflow to ignore custom parameters
validation {
    ignoreParams = ["proj_scratchdir_charite_user"]
}

// Process defaults (see https://docs.seqera.io/nextflow/reference/process/directives for more info)
process {
    clusterOptions       = "--qos=normal"
    executor             = "slurm"
    maxRetries           = 3
    queue                = "compute"
    resourceLimits       = [ cpus: 192, memory: 1.TB, time: 2.d ]
    scratch              = true
    stageInMode          = "symlink"
    stageOutMode         = "rsync"
    withLabel:process_gpu {
        clusterOptions   = { "--gres=gpu:${task.accelerator.request} --qos=normal" }
        containerOptions = "--nv"
        queue            = { task.accelerator.request > 1 ? "pgpu" : "gpu" }
        resourceLimits   = { task.accelerator.request > 1 ? [ cpus: 128, memory: 2.TB, time: 2.d ] : [ cpus: 64, memory: 500.GB, time: 2.d ] }
    }
}
    
// Slurm defaults (see https://docs.seqera.io/nextflow/reference/config/executor for more info)
executor {
    pollInterval      = 10.s
    queueSize         = 200
    queueStatInterval = 2.m
    submitRateLimit   = '2/1sec'
}

// Environment variables (see https://docs.seqera.io/nextflow/reference/config/env for more info)
env {
    APPTAINER_CACHEDIR  = "${params.proj_scratchdir_charite_user}/.apptainer"
    APPTAINER_TMPDIR    = "${params.proj_scratchdir_charite_user}/.apptainer/tmp"
}

// Container engine defaults (see https://docs.seqera.io/nextflow/reference/config/apptainer for more info)
// Specify where Apptainer will save built images.
// 1) If "NXF_APPTAINER_CACHEDIR" is defined by the user as an environment variable, it will be used as the image directory.
// 2) If not defined, the image directory used will default to "${params.proj_scratchdir_charite_user}/apptainer-images";
//    this is determined by the definition of the "PROJ_SCRATCHDIR_CHARITE_USER" variable.
//    See docs/charite.md for more info on how to set this variable.
apptainer {
    autoMounts  = true
    cacheDir    = System.getenv("NXF_APPTAINER_CACHEDIR") ?: "${params.proj_scratchdir_charite_user}/apptainer-images"
    enabled     = true
    pullTimeout = 2.h
}

// Specify Nextflow's work directory
workDir = "${params.proj_scratchdir_charite_user}/nxf-work"

// ----------------------
// Pipeline run analytics
// ----------------------

// Enable "dag" feature and allow overwriting of existing dag files (see https://docs.seqera.io/nextflow/reference/config/dag for more info)
dag {
    enabled   = true
    overwrite = true
}

// Enable "report" feature and allow overwriting of existing report files (see https://docs.seqera.io/nextflow/reference/config/report for more info)
report {
    enabled   = true
    overwrite = true
}

// Enable "trace" feature and allow overwriting of existing trace files (see https://docs.seqera.io/nextflow/reference/config/trace for more info)
trace {
    enabled   = true
    overwrite = true
}

// Enable "timeline" feature and allow overwriting of existing timeline files (see https://docs.seqera.io/nextflow/reference/config/timeline for more info)
timeline {
    enabled   = true
    overwrite = true
}
// ----------------------

// Additional profiles
// Some of the partitions below are not accessible to all user groups
// If you are having trouble running jobs on a partition you should have access to, get in touch with sc-hpc-helpdesk@charite.de
profiles {
    dragen_cc05 {
        process {
            queue          = "dragen_cc05"
            resourceLimits = [ cpus: 64, memory: 500.GB, time: 7.d ]
        }
    }
    dragen_cc15 {
        process {
            queue          = "dragen_cc15"
            resourceLimits = [ cpus: 64, memory: 500.GB, time: 7.d ]
        }
    }
    dragen_gp {
        process {
            queue          = "dragen_gp"
            resourceLimits = [ cpus: 48, memory: 240.GB, time: 7.d ]
        }
    }
    genomics {
        process {
            clusterOptions = "--exclude=s-sc-genomics[01]" // Reserved for demultiplexing
            queue          = "genomics"
            resourceLimits = [ cpus: 192, memory: 1.TB, time: 7.d ]
        }
    }
    highmem {
        process {
            queue          = { task.memory > 1.TB ? "highmem" : "compute" }
            resourceLimits = { task.memory > 1.TB ? [ cpus: 192, memory: 4.TB, time: 2.d ] : [ cpus: 192, memory: 1.TB, time: 2.d ] }
        }
    }
    // Disable automatic cleanup
    debug {
        cleanup = false
    }
}

// Cleanup after successful run
cleanup = true
