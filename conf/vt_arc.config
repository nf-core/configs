// nf-core/configs: Virginia Tech Advanced Research Computing (ARC), TinkerCliffs
// https://www.docs.arc.vt.edu/resources/compute/00tinkercliffs.html

params {
    config_profile_name        = 'Virginia Tech ARC TinkerCliffs'
    config_profile_description = 'Virginia Tech ARC TinkerCliffs cluster profile (SLURM, Apptainer)'
    config_profile_contact     = 'Jaret Arnold (@musharna)'
    config_profile_url         = 'https://arc.vt.edu'

    // REQUIRED: your ARC allocation account. sbatch rejects the job without it.
    arc_account = null
}

validation {
    ignoreParams = ['arc_account']
}

process {
    executor       = 'slurm'
    queue          = 'normal_q'
    clusterOptions = { "--account=${params.arc_account}" }
    // Apptainer is only on PATH after loading its module, including on compute nodes.
    beforeScript   = 'module load apptainer/1.4.0'

    // Largest normal_q node (128 cores, 1 TB; most nodes are 128 cores / 256 GB)
    // and the 7-day wall time of the default QoS (tc_normal_base).
    resourceLimits = [
        cpus  : 128,
        memory: 1000.GB,
        time  : 7.d
    ]
}

executor {
    queueSize       = 50
    submitRateLimit = '10/1min'
    pollInterval    = '30 sec'
}

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = System.getenv('NXF_APPTAINER_CACHEDIR') ?: "/scratch/${System.getenv('USER')}/.apptainer/nxf"
}
