/*
    * -------------------------------------------------
    *  Unity HPC cluster config file for nf-core
    * -------------------------------------------------
    * https://unityhpc.org/
    */

params {
    config_profile_description = 'Unity HPC cluster profile provided by nf-core/configs.'
    config_profile_contact = 'Berent Aldikacti (@baldikacti)'
    config_profile_url = 'https://unityhpc.org/'

    igenomes_base = '/datasets/bio/igenomes'

    max_memory = 2010.GB
    max_cpus = 192
    max_time = 5.d
}

process {
    resourceLimits = [
        cpus: 192,
        memory: 2010.GB,
        time: 5.d
    ]
    executor = 'slurm'

    // Selects partition based on process time
    queue = { task.time <= 2.h ? 'cpu-preempt' : 'cpu' }

    maxRetries = 2

}

// Limits job submission to 500 consecutive run and 5 submissions per second
executor {
    queueSize = 500
    submitRateLimit = '5sec'
    pollInterval = 1.m
    queueStatInterval = 2.m
}

apptainer {
    enabled = true
    autoMounts = true
    pullTimeout = 120.m
}

// clean the generated files in the working directory
cleanup = true
