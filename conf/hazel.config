// NC State University - Hazel HPC Cluster
// nf-core institutional config
// Scheduler: SLURM | Containers: Singularity/Apptainer
//
// To activate: nextflow run <pipeline> -profile hazel
//
// Submit an issue or PR to add this to the nf-core/configs repo:
// https://github.com/nf-core/configs

params {
    config_profile_name        = 'NC State University - Hazel HPC'
    config_profile_description = 'nf-core config for the Hazel HPC cluster at NC State University'
    config_profile_contact     = 'Seth Weaver (@sweavs111)'
    config_profile_url         = 'https://brc.ncsu.edu/'

    max_memory = 128.GB
    max_cpus   = 24
    max_time   = 120.h

    // Default GPU allocation. Override at runtime with --hazel_gpu 'gpu:<type>:<num>'
    hazel_gpu     = 'gpu:l40:1'

    // Default partitions. Override at runtime with --partition or --gpu_partition
    partition     = 'compute'
    gpu_partition = 'gpu'
}

validation {
    ignoreParams = ['hazel_gpu', 'partition', 'gpu_partition']
}

// ─── Singularity ────────────────────────────────────────────────────────────
singularity {
    enabled    = true
    autoMounts = true

    // Read-only, BRC-maintained image repository pre-populated for OOD
    // pipeline apps. Nextflow checks libraryDir before cacheDir, so this
    // gives every user -- not just OOD runs -- a shared-cache-first lookup
    // with no extra setup: nothing outside the BRC download process ever
    // writes here, so it's safe to default to for everyone.
    libraryDir = System.getenv('NXF_SINGULARITY_LIBRARYDIR') ?: '/gpfs_backup/bioinfo_data/nf-core_ood/container_cache'

    // Writable fallback for any image libraryDir doesn't have. OOD apps
    // export NXF_SINGULARITY_CACHEDIR pointing at the same shared cache
    // above, so a first-time pull there also grows the shared pool for
    // everyone else. Manual users without that set get their own scratch
    // cache instead, so they never need write access to the shared one.
    cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: System.getenv('APPTAINER_CACHEDIR') ?: "/share/${System.getenv('GROUP')}/${System.getenv('USER')}/.nf_singularity_cache"

    // autoMounts doesn't bind Hazel's system $TMPDIR, breaking tools that use it
    runOptions = '-B ${TMPDIR:-/tmp}'
}

// ─── Executor tuning ────────────────────────────────────────────────────────
executor {
    queueSize         = 16
    pollInterval      = '1 min'
    queueStatInterval = '5 min'
    submitRateLimit   = '10 sec'
}

// ─── Process defaults ────────────────────────────────────────────────────────
process {
    beforeScript = 'module load singularity'
    executor     = 'slurm'
    queue        = params.partition

    resourceLimits = [
        memory: params.max_memory,
        cpus:   params.max_cpus,
        time:   params.max_time
    ]

    // GPU jobs use gpu partition and need --nv for the container to see the device
    withLabel: 'process_gpu' {
        queue            = params.gpu_partition
        clusterOptions   = { "--gres=${params.hazel_gpu}" }
        containerOptions = '--nv'
    }
}
