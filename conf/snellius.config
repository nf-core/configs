// Nextflow config for running on Snellius, the Dutch national supercomputer hosted at SURF
params {
    config_profile_description = 'Snellius, the Dutch national supercomputer hosted at SURF.'
    config_profile_contact     = 'Barbara Verhaar (@barbarahelena)'
    config_profile_url         = 'https://servicedesk.surf.nl/wiki/spaces/WIKI/pages/30660184/Snellius'
}

apptainer {
    enabled     = true
    autoMounts  = true
    // Default of 20 minutes is too short for large images
    pullTimeout = '3h'
}

process {
    // Available memory per node as listed on the Snellius partitions page (genoa)
    resourceLimits = [
        memory: 336.GB,
        cpus: 192,
        time: 120.h
    ]
    executor       = 'slurm'
    // Small jobs fit in the smallest rome allocation (1/8 node: 16 cores, 28 GB), which is billed for fewer cores than genoa (24 cores).
    queue          = { (task.cpus <= 16 && task.memory <= 28.GB) ? 'rome' : 'genoa' }
}

executor {
    queueSize       = 100
    submitRateLimit = '30/1min'
}

profiles {
    // The fat_genoa partition needs a separate budget, which has to be requested in the Snellius application
    fat_genoa {
        process {
            // Available memory per node as listed on the Snellius partitions page (fat_genoa)
            resourceLimits = [
                memory: 1440.GB,
                cpus: 192,
                time: 120.h
            ]
            // genoa nodes have 336 GB, larger jobs go to the fat_genoa nodes
            queue          = {
                task.memory > 336.GB ? 'fat_genoa' :
                (task.cpus <= 16 && task.memory <= 28.GB) ? 'rome' : 'genoa'
            }
        }
    }
}
