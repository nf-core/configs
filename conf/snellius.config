// Nextflow config for running on Snellius, the Dutch national supercomputer hosted at SURF
params {
    config_profile_description = 'Snellius, the Dutch national supercomputer hosted at SURF.'
    config_profile_contact     = 'Barbara Verhaar (@barbarahelena)'
    config_profile_url         = 'https://servicedesk.surf.nl/wiki/spaces/WIKI/pages/30660184/Snellius'

    // Partitions covered by your budget (see the 'Products' line of accinfo), e.g. --snellius_nodes 'rome,genoa,fat_genoa'
    snellius_nodes             = 'rome,genoa'
}

validation {
    ignoreParams = ['snellius_nodes']
}

apptainer {
    enabled     = true
    autoMounts  = true
    pullTimeout = 3.h
}

process {
    // Largest node the budget covers, using the available memory per node from the Snellius partitions page.
    // GPU and service partitions (staging, cbuild) are not included in this yet
    resourceLimits = {
        def nodes = [
            rome     : [cpus: 128, memory: 224.GB],
            genoa    : [cpus: 192, memory: 336.GB],
            fat_rome : [cpus: 128, memory: 960.GB],
            fat_genoa: [cpus: 192, memory: 1440.GB],
            himem_4tb: [cpus: 128, memory: 3840.GB],
            himem_8tb: [cpus: 128, memory: 7680.GB]
        ]
        def available = nodes.subMap(params.snellius_nodes.tokenize(',')).values().toList() ?: [nodes.genoa]
        return [
            cpus  : available.collect { node -> node.cpus }.max(),
            memory: available.collect { node -> node.memory }.max(),
            time  : 120.h
        ]
    }.call()
    executor       = 'slurm'
    // Jobs without a partition only go to rome, and Snellius accepts only one partition for shared jobs,
    // so each task is sent to the first listed partition it fits on, from cheapest and smallest to largest
    queue          = {
        def nodes = [
            [name: 'rome', cpus: 128, memory: 224.GB],
            [name: 'genoa', cpus: 192, memory: 336.GB],
            [name: 'fat_rome', cpus: 128, memory: 960.GB],
            [name: 'fat_genoa', cpus: 192, memory: 1440.GB],
            [name: 'himem_4tb', cpus: 128, memory: 3840.GB],
            [name: 'himem_8tb', cpus: 128, memory: 7680.GB]
        ]
        def listed = nodes.findAll { node -> node.name in params.snellius_nodes.tokenize(',') }.toList() ?: [nodes[1]]
        def fits   = listed.find { node -> task.cpus <= node.cpus && (task.memory ?: 0.GB) <= node.memory }
        return (fits ?: listed.max { node -> node.memory }).name
    }
}

executor {
    queueSize       = 100
    submitRateLimit = '30/1min'
    // Slurm on Snellius does not accept special characters such as ':', '(' and ')' in job names
    jobName         = { task.name.replaceAll('[^a-zA-Z0-9_]', '_') }
}
