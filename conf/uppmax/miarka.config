// Used by https://github.com/nf-core/configs/blob/master/conf/uppmax.config
// Updates settings for Miarka

params {
    config_profile_description = 'UPPMAX (Miarka) cluster profile provided by nf-core/configs.'
    miarka_gpu_type            = null // Default accelerator type when a task doesn't request one; null = any free GPU
    max_cpus                   = 48
    max_memory                 = 357.GB // Raise to at most 2000.GB (m101) or 3998.GB (m102) to allow the high-memory nodes
    max_time                   = 480.h
}

// Hardware: https://www.uu.se/en/centre/uppmax/resources/clusters/miarka
process {
    // Memory fits a regular 384 GB node unless --max_memory is raised, which then
    // lets the high-memory branch in clusterOptions below send tasks to the 2 TB or 4 TB node.
    // Usable memory per node (sinfo, MiB): m1-m68 384000, m101 2048522, m102 4094000, m201 512000, m202 384000
    resourceLimits = [
        cpus: 48,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time: 480.h,
    ]

    clusterOptions = {
        def gpu_directive = ""
        // Follows the nf-core GPU guidelines: https://nf-co.re/docs/developing/components/gpu-modules
        // Most pipelines run here predate the nf-core `gpu` profile, so a task gets a GPU either
        // from its `accelerator` directive or, failing that, from carrying the `process_gpu` label.
        // The GPU type defaults to params.miarka_gpu_type unless the accelerator specifies one.
        // Without any type, Slurm may place the task on whichever GPU node is free.
        if (task.accelerator || 'process_gpu' in (task.label ?: [])) {
            // One node per GPU type, both in the `gpu` partition: m201 (4x A100), m202 (6x L40S)
            def gpu_nodes = [
                'a100': [gpus: 4, cpus: 96, memory: 500.GB],
                'l40s': [gpus: 6, cpus: 64, memory: 375.GB],
            ]
            def gpu_type = task.accelerator?.type ?: params.miarka_gpu_type
            def gpu_count = (task.accelerator?.request ?: 1) as Integer
            if (gpu_type && !gpu_nodes.containsKey(gpu_type)) {
                throw new IllegalArgumentException(
                    "accelerator type '${gpu_type}' is unknown. Valid types: ${gpu_nodes.keySet().sort().join(', ')}"
                )
            }
            // Fail early on requests no GPU node can satisfy, instead of pending in the queue forever
            def nodes = gpu_type ? [gpu_nodes[gpu_type]] : gpu_nodes.values()
            if (!nodes.any { node -> gpu_count <= node.gpus && task.cpus <= node.cpus && (!task.memory || task.memory <= node.memory) }) {
                throw new IllegalArgumentException(
                    "no ${gpu_type ?: 'GPU'} node on Miarka fits ${gpu_count} GPU(s), ${task.cpus} CPUs and ${task.memory}"
                )
            }
            gpu_directive = "-p gpu --gres=gpu:${gpu_type ? gpu_type + ':' : ''}${gpu_count}"
        }

        // Constrain by node feature rather than adding a second --mem, which would override
        // Nextflow's own --mem (and `--mem 2TB` exceeds what m101 can actually allocate).
        def mem_directive = task.memory > 357.GB
            ? (task.memory <= 2000.GB ? '-C mem2TB|mem4TB' : '-C mem4TB')
            : ""

        [
            "-A ${params.project}",
            (params.clusterOptions as String) ?: "",
            gpu_directive ?: mem_directive,
        ].findAll { opt -> opt }.join(" ")
    }

    // Enables GPU access inside the Apptainer container only for GPU tasks (same test as above),
    // so CPU tasks don't warn about missing NVIDIA libraries.
    containerOptions = { (task.accelerator || 'process_gpu' in (task.label ?: [])) ? '--nv' : '' }
}
