// Used by https://github.com/nf-core/configs/blob/master/conf/uppmax.config
// Updates settings for Miarka

params {
    config_profile_description = 'UPPMAX (Miarka) cluster profile provided by nf-core/configs.'
    miarka_gpu_type            = 'l40s' // Default accelerator type when a task doesn't request a specific one
    max_cpus                   = 48
    max_memory                 = 357.GB
    max_time                   = 480.h
}

// Hardware: https://www.uu.se/en/centre/uppmax/resources/clusters/miarka
// Usable memory per node (sinfo, MiB): m1-m68 384000, m101 2048522, m102 4094000, m201 512000, m202 384000
process {
    resourceLimits = [
        cpus: 48,
        memory: 357.GB,
        time: 480.h,
    ]

    clusterOptions = {
        def gpu_directive = ""
        // Follows the nf-core GPU guidelines: https://nf-co.re/docs/developing/components/gpu-modules
        // GPU nodes (m201: 4x A100, m202: 6x L40S) are both in the `gpu` partition.
        if (task.accelerator) {
            def gpu_type = task.accelerator.type ?: params.miarka_gpu_type
            gpu_directive = "-p gpu --gres=${gpu_type}:${task.accelerator.request ?: 1}"
        }

        [
            "-A ${params.project}",
            params.clusterOptions ?: "",
            gpu_directive ?: (task.memory > 357.GB ? (task.memory <= 2000.GB ? '--mem 2TB' : '-c mem4TB') : ""),
        ].minus("").join(" ")
    }

    // Enables GPU access inside the container when a task requests an accelerator.
    containerOptions = { task.accelerator ? '--nv' : '' }
}


singularity {
    runOptions = '-B $SNIC_TMP'
    // Forward Slurm's per-job GPU visibility restriction into the container.
    envWhitelist = 'SNIC_TMP,CUDA_VISIBLE_DEVICES'
}
