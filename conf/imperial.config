//Profile config names for nf-core/configs

params {
    // Config Params
    config_profile_description = 'Imperial College London - HPC Profile -- provided by nf-core/configs.'
    config_profile_contact     = 'Nurun Fancy (@nfancy)'
    config_profile_url         = 'https://www.imperial.ac.uk/admin-services/ict/self-service/research-support/rcs/'

    // Resources: the largest single-node job CX3 accepts (a Nextflow task always runs on one node)
    max_memory                 = 920.GB
    max_cpus                   = 128
    max_time                   = 72.h
}

process {
    resourceLimits = [
        memory: 920.GB,
        cpus: 128,
        time: 72.h
    ]
}

profiles {
    imperial {
        process {
            executor   = 'pbspro'

            // Each pipeline's own resource labels and error strategy apply, capped by resourceLimits above.
            // One more retry than the nf-core default; nf-core pipelines only retry on
            // killed / out-of-memory / walltime exit codes.
            maxRetries = 2

            // GPUs. PBS Pro ignores cpus and memory when clusterOptions contains -l,
            // so the select statement is built from the task's own resources.
            // Set IMPERIAL_GPU_TYPE (e.g. L40S or A100) to ask for a particular GPU type.

            // nf-core modules: process_gpu tasks get a GPU when the pipeline is run with -profile gpu,
            // as in the nf-core template. accelerator is repeated here because this block can replace
            // the pipeline's own process_gpu block rather than merge with it.
            withLabel: process_gpu {
                accelerator      = { workflow.profile.contains('gpu') ? 1 : null }
                clusterOptions   = {
                    workflow.profile.contains('gpu')
                        ? "-l select=1:ncpus=${task.cpus}:mem=${task.memory.toMega()}mb:ngpus=1" + (System.getenv('IMPERIAL_GPU_TYPE') ? ":gpu_type=${System.getenv('IMPERIAL_GPU_TYPE')}" : '')
                        : null
                }
                containerOptions = {
                    workflow.profile.contains('gpu')
                        ? (workflow.containerEngine == "singularity" ? '--nv --env CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES' : (workflow.containerEngine == "docker" ? '--gpus all' : null))
                        : null
                }
            }

            // nf-core/scflow: with_gpus always requests one GPU
            withLabel: with_gpus {
                clusterOptions   = {
                    "-l select=1:ncpus=${task.cpus}:mem=${task.memory.toMega()}mb:ngpus=1" + (System.getenv('IMPERIAL_GPU_TYPE') ? ":gpu_type=${System.getenv('IMPERIAL_GPU_TYPE')}" : '')
                }
                containerOptions = {
                    workflow.containerEngine == "singularity"
                        ? '--nv --env CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES'
                        : (workflow.containerEngine == "docker" ? '--gpus all' : null)
                }
            }
        }
    }
    medbio {
        process {
            executor = 'pbspro'
        }
    }
}

executor {
    '$pbspro' {
        // Per pipeline run. CX3 allows each user 1000 queued jobs and 500 running CPUs (qstat -Bf);
        // 200 lets single-CPU tasks use most of the CPU allowance and leaves room for several runs at once.
        queueSize       = 200
        submitRateLimit = '10/1sec'
    }

    '$local' {
        cpus      = 2
        queueSize = 1
        memory    = '6 GB'
    }
}

singularity {
    enabled     = true
    autoMounts  = true
    // $TMPDIR is job-local scratch that PBS creates on the compute node and clears when the job ends.
    // Single quotes so it is expanded on the compute node, not when the config is read on the login node.
    // It is bound at its own path as well as /tmp; /var/tmp is not remapped, so $TMPDIR still exists
    // inside the container.
    runOptions  = '-B /rds/,$TMPDIR,$TMPDIR:/tmp'
    // Converting a large image on RDS often takes longer than the 20 minute default
    pullTimeout = '2h'
    // A config cacheDir overrides NXF_SINGULARITY_CACHEDIR, so respect it when it is set
    cacheDir    = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "/rds/general/user/${System.getenv('USER')}/ephemeral/singularity_cache"
}
