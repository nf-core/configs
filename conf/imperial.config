//Profile config names for nf-core/configs

params {
    // Config Params
    config_profile_description = 'Imperial College London - HPC Profile -- provided by nf-core/configs.'
    config_profile_contact     = 'Nurun Fancy (@nfancy)'
    config_profile_url         = 'https://www.imperial.ac.uk/admin-services/ict/self-service/research-support/rcs/'

    // Resources: the largest single-node job CX3 accepts (a Nextflow task always runs on one node)
    max_memory                 = 920.GB
    max_cpus                   = 128
    max_time                   = 72.h
}

process {
    resourceLimits = [
        memory: 920.GB,
        cpus: 128,
        time: 72.h
    ]
}

profiles {
    imperial {
        process {
            executor   = 'pbspro'

            // Each pipeline's own resource labels and error strategy apply, capped by resourceLimits above.
            // One more retry than the nf-core default; nf-core pipelines only retry on
            // killed / out-of-memory / walltime exit codes.
            maxRetries = 2

            // GPUs: any task with an accelerator (nf-core's process_gpu label sets one when the
            // pipeline is run with -profile gpu) is given GPUs. PBS Pro ignores
            // cpus and memory when clusterOptions contains -l, so the select statement is built from
            // the task's own resources. Set IMPERIAL_GPU_TYPE (e.g. L40S or A100) to ask for a GPU type.
            clusterOptions = {
                task.accelerator
                    ? "-l select=1:ncpus=${task.cpus}:mem=${task.memory.toMega()}mb:ngpus=${task.accelerator.request}" + (System.getenv('IMPERIAL_GPU_TYPE') ? ":gpu_type=${System.getenv('IMPERIAL_GPU_TYPE')}" : '')
                    : null
            }
        }
    }
    medbio {
        process {
            executor = 'pbspro'
        }
    }
}

executor {
    '$pbspro' {
        // Per pipeline run. CX3 allows each user 1000 queued jobs and 500 running CPUs (qstat -Bf);
        // 200 lets single-CPU tasks use most of the CPU allowance and leaves room for several runs at once.
        queueSize       = 200
        submitRateLimit = '10/1sec'
    }

    '$local' {
        cpus      = 2
        queueSize = 1
        memory    = '6 GB'
    }
}

singularity {
    enabled     = true
    autoMounts  = true
    // $TMPDIR is job-local scratch that PBS creates on the compute node and clears when the job ends.
    // Single quotes so it is expanded on the compute node, not when the config is read on the login node.
    // It is bound at its own path as well as /tmp; /var/tmp is not remapped, so $TMPDIR still exists
    // inside the container. --nv makes GPUs visible in tasks that are given one and does nothing
    // on CPU nodes; it is needed here because this setting replaces the --nv from -profile gpu.
    runOptions  = '-B /rds/,$TMPDIR,$TMPDIR:/tmp --nv'
    // Converting a large image on RDS often takes longer than the 20 minute default
    pullTimeout = '2h'
    // A config cacheDir overrides NXF_SINGULARITY_CACHEDIR, so respect it when it is set
    cacheDir    = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "/rds/general/user/${System.getenv('USER')}/ephemeral/singularity_cache"
}
