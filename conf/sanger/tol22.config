// tol22 cluster at Wellcome Sanger Institute
// As opposite to the default farm22 settings, we don't mount any filesystem by default.
// Pipelines that need to see certain filesystems have to set singularity.runOptions themselves
// The queues also slightly differ.

params {
    max_memory                = 1.4.TB
    max_cpus                  = 64
    // 62 days
    max_time                  = 89280.min

    // LSF group for GPU jobs
    sanger_gpu_group          = null
    sanger_gpu_queue          = null
    sanger_use_farm22_hugemem = null
}

process {
    resourceLimits = [memory: params.max_memory, cpus: params.max_cpus, time: params.max_time]

    queue          = {
        if (task.accelerator) {
            return params.sanger_gpu_queue ?: error("Error: sanger_gpu_queue parameter is not set")
        }
        if (task.time >= 15.d) {
            if (task.memory > 680.GB) {
                error("There is no queue for jobs that need >680 GB and >15 days")
            }
            else {
                return "basement"
            }
        }
        else if (task.memory > 720.GB) {
            return params.sanger_use_farm22_hugemem ? "farm22-hugemem" : "teramem"
        }
        else if (task.memory > 350.GB) {
            return params.sanger_use_farm22_hugemem ? "farm22-hugemem" : "hugemem"
        }
        else if (task.time > 7.d) {
            return "basement"
        }
        else if (task.time > 2.d) {
            return "week"
        }
        else if (task.time > 12.h) {
            return "long"
        }
        else if (task.time > 1.m || !task.time) {
            return "normal"
        }
        else {
            return "small"
        }
    }
}
