// farm22 cluster at Wellcome Sanger Institute

params {
    max_memory       = 3.8.TB
    max_cpus         = 256
    max_time         = 43200.min
    // 30 days

    // LSF group for GPU jobs
    sanger_gpu_group = null
}

process {
    resourceLimits = [memory: '3.8 TB' as MemoryUnit, cpus: 256, time: 43200.m]

    queue          = {
        if (task.memory > 350.GB) {
            return "hugemem"
        }
        else if (task.time > 7.d) {
            return "basement"
        }
        else if (task.time > 2.d) {
            return "week"
        }
        else if (task.time > 12.h) {
            return "long"
        }
        else {
            return "normal"
        }
    }

    withLabel: '(gpu|process_gpu)' {
        clusterOptions   = {
            def group_arg = params.gpu_group ? "-G ${params.gpu_group}" : ""
            group_arg + "-gpu 'num=1:j_exclusive=yes'"
        }
        queue            = { task.time > 7.d ? 'gpu-basement' : 'gpu' }
        containerOptions = {
            workflow.containerEngine == "singularity"
                ? '--containall --cleanenv --nv'
                : (workflow.containerEngine == "docker" ? '--gpus all' : null)
        }
    }
}

singularity {
    // Mount all filesystems by default
    runOptions = '--bind /lustre --bind /nfs --bind /data --bind /software'
}
