// farm22 cluster at Wellcome Sanger Institute

params {
    max_memory                = 3.8.TB
    max_cpus                  = 256
    // 30 days
    max_time                  = 43200.min

    // LSF group for GPU jobs
    sanger_gpu_group          = null
    sanger_gpu_queue          = null
    sanger_use_farm22_hugemem = null
}

process {
    resourceLimits = [memory: params.max_memory, cpus: params.max_cpus, time: params.max_time]

    withLabel: '(gpu|process_gpu)' {
        queue = { params.sanger_gpu_queue ?: task.time > 7.d ? 'gpu-basement' : 'gpu' }
    }

    queue          = {
        if (task.accelerator) {
            return params.sanger_gpu_queue ?: task.time > 7.d ? 'gpu-basement' : 'gpu'
        }
        if (task.memory > 350.GB) {
            return "hugemem"
        }
        else if (task.time > 7.d) {
            return "basement"
        }
        else if (task.time > 2.d) {
            return "week"
        }
        else if (task.time > 12.h) {
            return "long"
        }
        else {
            return "normal"
        }
    }
}

singularity {
    // Mount all filesystems by default
    runOptions = '--bind /lustre --bind /nfs --bind /data --bind /software'
}
